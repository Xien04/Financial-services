# Copy this file to .env and provide local values. Never commit .env.

# Application
APP_ENV=
APP_URL=
# APP_URL is the public origin used in password-reset links (no trailing path).
DJANGO_SETTINGS_MODULE=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
NEXT_PUBLIC_API_URL=

# Password-recovery SMTP. Use a local mail catcher for development;
# never use the console email backend, which prints reset links to logs.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=

# Optional positive-integer authentication limits; blank uses the defaults
# documented in docs/AUTHENTICATION.md.
AUTH_LOGIN_ACCOUNT_LIMIT=
AUTH_LOGIN_IP_LIMIT=
AUTH_RECOVERY_ACCOUNT_LIMIT=
AUTH_RECOVERY_IP_LIMIT=
AUTH_RESET_ACCOUNT_LIMIT=
AUTH_RESET_IP_LIMIT=

# PostgreSQL
# Use separate administrator and application credentials. DATABASE_URL uses
# APP_DB_USER credentials; that role cannot administer PostgreSQL.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
APP_DB_USER=
APP_DB_PASSWORD=
DATABASE_URL=

# Tests only: a separate disposable PostgreSQL instance/role with CREATEDB.
# The test runner creates/destroys test_financial_services on this server.
# Application DATABASE_URL is never used by config.settings.test.
TEST_DATABASE_URL=

# Next.js server-side API origin (Compose supplies http://api:8000).
API_INTERNAL_URL=

# Background jobs
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Storage: use local for basic self-hosting or s3 for compatible object storage
STORAGE_BACKEND=
STORAGE_LOCAL_ROOT=
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Encryption and security
FIELD_ENCRYPTION_KEY=
SECURE_COOKIES=

# Observability
LOG_LEVEL=
SENTRY_DSN=

# Optional future Google integration. Point to an ignored local file; do not
# commit the service-account JSON or encode its contents in this template.
GOOGLE_APPLICATION_CREDENTIALS=
