# Copy this file to .env and provide local values. Never commit .env.

# Application
APP_ENV=
APP_URL=
DJANGO_SETTINGS_MODULE=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
NEXT_PUBLIC_API_URL=

# PostgreSQL
DATABASE_URL=

# Background jobs
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Storage: use local for basic self-hosting or s3 for compatible object storage
STORAGE_BACKEND=
STORAGE_LOCAL_ROOT=
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Encryption and security
FIELD_ENCRYPTION_KEY=
SECURE_COOKIES=

# Observability
LOG_LEVEL=
SENTRY_DSN=

# Optional future Google integration. Point to an ignored local file; do not
# commit the service-account JSON or encode its contents in this template.
GOOGLE_APPLICATION_CREDENTIALS=
